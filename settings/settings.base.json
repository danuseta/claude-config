{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Skill",
      "Agent",
      "WebSearch",
      "Bash(rtk git status:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git log:*)",
      "Bash(rtk git show:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(rtk git branch:*)",
      "Bash(rtk git worktree:*)",
      "Bash(rtk git add:*)",
      "Bash(rtk git commit:*)",
      "Bash(git switch:*)",
      "Bash(rtk git fetch:*)",
      "Bash(rtk git pull:*)",
      "Bash(rtk git push:*)",
      "Bash(rtk read:*)",
      "Bash(rtk rg:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk find:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk tree:*)",
      "Bash(rtk wc:*)",
      "Bash(rtk json:*)",
      "Bash(rtk diff:*)",
      "Bash(rtk tsc:*)",
      "Bash(rtk lint:*)",
      "Bash(rtk prettier:*)",
      "Bash(rtk jest:*)",
      "Bash(rtk vitest:*)",
      "Bash(rtk gh pr view:*)",
      "Bash(rtk gh pr list:*)",
      "Bash(rtk gh pr diff:*)",
      "Bash(rtk gh pr checks:*)",
      "Bash(rtk gh pr status:*)",
      "Bash(rtk gh pr create:*)",
      "Bash(rtk gh run view:*)",
      "Bash(rtk gh run list:*)",
      "Bash(bd:*)",
      "Bash(playwright-cli:*)",
      "Bash(node {{configDir}}/kit/status.cjs:*)",
      "mcp__claude_ai_Atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian__atlassianUserInfo",
      "mcp__atlassian__atlassianUserInfo",
      "mcp__claude_ai_Atlassian__lookupJiraAccountId",
      "mcp__atlassian__lookupJiraAccountId",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "mcp__atlassian__getJiraIssue",
      "mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian__getTransitionsForJiraIssue",
      "mcp__atlassian__getTransitionsForJiraIssue",
      "mcp__claude_ai_Atlassian__getJiraIssueTypeMetaWithFields",
      "mcp__atlassian__getJiraIssueTypeMetaWithFields",
      "mcp__claude_ai_Atlassian__getConfluencePage",
      "mcp__atlassian__getConfluencePage",
      "mcp__claude_ai_Atlassian__searchConfluenceUsingCql",
      "mcp__atlassian__searchConfluenceUsingCql",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
      "mcp__atlassian__addCommentToJiraIssue",
      "mcp__figma__get_design_context",
      "mcp__figma__get_screenshot",
      "mcp__figma__get_metadata",
      "mcp__figma__get_variable_defs"
    ],
    "deny": [
      "Grep",
      "Glob",
      "Bash(git push origin development:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push -f:*)",
      "Bash(git add .:*)",
      "Bash(git add -A:*)",
      "Bash(rtk git push origin development:*)",
      "Bash(rtk git push origin main:*)",
      "Bash(rtk git push origin master:*)",
      "Bash(rtk git push -f:*)",
      "Bash(rtk git add .:*)",
      "Bash(rtk git add -A:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(rtk git push --force:*)",
      "Bash(rm:*)",
      "Bash(rtk gh pr merge:*)",
      "Bash(rtk gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:dock-push.cjs hook}}",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:guard.cjs}} || exit 2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:scope-allow.cjs}}",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:dock-push.cjs hook}}",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{python}} \"{{configDir}}/kit/brain.py\" hook-autosave",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:dock-push.cjs hook}}",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:dock-push.cjs hook}}",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:dock-push.cjs hook}}",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{python}} \"{{configDir}}/kit/brain.py\" hook-retrieval",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{kit:status.cjs sync --hook}}",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typesafe@typesafe-ai": true,
    "caveman@caveman": true,
    "oh-my-claudecode@omc": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "{{kit:statusline.cjs}}"
  }
}
