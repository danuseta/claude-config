{
  "env": {
    "BRAIN_MODE": "remote"
  },
  "permissionsRemove": {
    "ask": ["Bash(rm:*)", "Bash(rtk rm:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$DOCK_RTK\" = off ] || rtk hook claude"
          }
        ]
      }
    ]
  }
}
