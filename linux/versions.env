# Pins, checksums and switches for the Linux runtime; an empty version or SHA256 means not pinned yet and that install is refused.
TAILSCALE_VERSION=${TAILSCALE_VERSION:-1.102.3}
TAILSCALE_SHA256=${TAILSCALE_SHA256:-a0fa1b154af8c61f862a2259f559f7396d96c0225f4a863eae2333e1546bbe25}
TAILSCALE_URL=${TAILSCALE_URL:-https://pkgs.tailscale.com/stable/tailscale_%V_arm64.tgz}
TAILSCALE_FORMAT=${TAILSCALE_FORMAT:-tgz}
TAILSCALE_BINS=${TAILSCALE_BINS:-tailscale,tailscaled}
RTK_VERSION=${RTK_VERSION:-0.43.0}
RTK_SHA256=${RTK_SHA256:-5519f7ca12e5c143a609f0d28a0a77b97413a8dce31c2681f1a41c24519a8731}
RTK_URL=${RTK_URL:-https://github.com/rtk-ai/rtk/releases/download/v%V/rtk-aarch64-unknown-linux-gnu.tar.gz}
RTK_FORMAT=${RTK_FORMAT:-tgz}
RTK_BINS=${RTK_BINS:-rtk}
BD_VERSION=${BD_VERSION:-1.2.2}
BD_SHA256=${BD_SHA256:-501f38a1070d4b9b3b6261a86a3c92c4a52366869021560430a4bb0036afd83a}
BD_URL=${BD_URL:-https://github.com/gastownhall/beads/releases/download/v%V/beads_%V_linux_arm64.tar.gz}
BD_FORMAT=${BD_FORMAT:-tgz}
BD_BINS=${BD_BINS:-bd}
UV_VERSION=${UV_VERSION:-0.11.32}
UV_SHA256=${UV_SHA256:-4d4fa08d95b06642e5800df6a22bd71455f23f988269e18da2847971d8c0bf31}
UV_URL=${UV_URL:-https://github.com/astral-sh/uv/releases/download/%V/uv-aarch64-unknown-linux-gnu.tar.gz}
UV_FORMAT=${UV_FORMAT:-tgz}
UV_BINS=${UV_BINS:-uv,uvx}
RG_VERSION=${RG_VERSION:-15.1.0}
RG_SHA256=${RG_SHA256:-2b661c6ef508e902f388e9098d9c4c5aca72c87b55922d94abdba830b4dc885e}
RG_URL=${RG_URL:-https://github.com/BurntSushi/ripgrep/releases/download/%V/ripgrep-%V-aarch64-unknown-linux-gnu.tar.gz}
RG_FORMAT=${RG_FORMAT:-tgz}
RG_BINS=${RG_BINS:-rg}
PIN_TOOLS=${PIN_TOOLS:-TAILSCALE RTK BD UV RG}
TS_HOSTNAME=${TS_HOSTNAME:-coder-danu}
TS_TAG=${TS_TAG:-tag:coder-ws}
TS_PROXY_PORT=${TS_PROXY_PORT:-1055}
TS_AUTH_METHOD=${TS_AUTH_METHOD:-file}
PROXY_MODE=${PROXY_MODE:-env}
DETACH_MODE=${DETACH_MODE:-setsid}
BASHRC_FALLBACK=${BASHRC_FALLBACK:-0}
BRIDGE_PERMISSION_MODE=${BRIDGE_PERMISSION_MODE:-}
BRIDGE_CWD=${BRIDGE_CWD:-$HOME/projects}
BRIDGE_TURN_TIMEOUT_MS=${BRIDGE_TURN_TIMEOUT_MS:-14400000}
# BRAIN_URL and BRAIN_TOKEN keep brain.py on the shared DOCK once DOCK_INGEST_URL points at this workspace's own DOCK.
BRIDGE_SECRET_NAMES=${BRIDGE_SECRET_NAMES:-DOCK_INGEST_URL DOCK_INGEST_TOKEN BRAIN_URL BRAIN_TOKEN}
ENABLE_QONFLO_COORD=${ENABLE_QONFLO_COORD:-0}
QONFLO_COORD_URL=${QONFLO_COORD_URL:-}
QONFLO_COORD_BRANCH=${QONFLO_COORD_BRANCH:-master}
# ENABLE_BRAIN=1 is forbidden on the shared server: the workspace uses ~/.claude/kit/brain.py in remote mode and must not clone ~/brain.
ENABLE_BRAIN=${ENABLE_BRAIN:-0}
BRAIN_REPO=${BRAIN_REPO:-danuseta/brain}
# The workspace runs its own DOCK (DOCK_MODE=workspace): chat and runs of this workspace, no calendar or Docker pages.
ENABLE_DOCK=${ENABLE_DOCK:-1}
DOCK_REPO=${DOCK_REPO:-danuseta/dock}
DOCK_APP_DIR=${DOCK_APP_DIR:-$HOME/.local/share/dock-app}
DOCK_DATA_DIR=${DOCK_DATA_DIR:-$HOME/.local/state/dock}
DOCK_PORT=${DOCK_PORT:-4100}
ACL_PROBE_ADDR=${ACL_PROBE_ADDR:-}
SUPERVISE_BACKOFF_MIN=${SUPERVISE_BACKOFF_MIN:-2}
SUPERVISE_BACKOFF_MAX=${SUPERVISE_BACKOFF_MAX:-60}
SUPERVISE_STABLE_SECS=${SUPERVISE_STABLE_SECS:-60}
LOG_MAX_BYTES=${LOG_MAX_BYTES:-2097152}
LOG_KEEP=${LOG_KEEP:-2}
STEP_TIMEOUT_SECS=${STEP_TIMEOUT_SECS:-600}
TOOLCHAIN_WAIT_SECS=${TOOLCHAIN_WAIT_SECS:-900}
