#!/usr/bin/env bash
# Run a kit script with Node: kit-node <file> [args...], where <file> is relative to the kit folder (e.g. status.cjs).
# On Linux it first loads ~/.config/claude-config/secrets.env and sends Node's fetch through the tailscaled proxy.
# On Windows it only resolves the kit folder and runs node.
set -u
KIT=$(cd "$(dirname "$0")/.." && { pwd -W 2>/dev/null || pwd -P; })
FILE=${1:-}
[ -n "$FILE" ] || { echo "kit-node: usage: kit-node <file> [args...] (file is relative to $KIT)" >&2; exit 2; }
shift
[ -f "$KIT/$FILE" ] || { echo "kit-node: $KIT/$FILE does not exist" >&2; exit 2; }

if [ "$(uname -s)" = Linux ]; then
	command -v node > /dev/null 2>&1 || { [ -f "$HOME/.config/qonflo/env.sh" ] && . "$HOME/.config/qonflo/env.sh"; }
	SECRETS="$HOME/.config/claude-config/secrets.env"
	if [ -f "$SECRETS" ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			case "$line" in ''|'#'*) continue;; esac
			k=${line%%=*}; v=${line#*=}
			case "$k" in ''|[0-9]*|*[!A-Za-z0-9_]*) continue;; esac
			case "$v" in \"*\") v=${v#\"}; v=${v%\"};; \'*\') v=${v#\'}; v=${v%\'};; esac
			export "$k=$v"
		done < "$SECRETS"
	fi
	extra=""
	for u in "${CODER_AGENT_URL:-}" "${CODER_URL:-}"; do
		h=${u#*://}; h=${h%%/*}; h=${h%%:*}
		[ -n "$h" ] && extra="$extra,$h"
	done
	ts=${ENABLE_TAILSCALE:-}
	if [ -z "$ts" ] && [ -f "${CCFG_VERSIONS_FILE:-$HOME/.config/claude-config/versions.local.env}" ]; then
		ts=$(sed -n 's/^ENABLE_TAILSCALE=//p' "${CCFG_VERSIONS_FILE:-$HOME/.config/claude-config/versions.local.env}" | tail -n 1 | tr -d "\"'")
	fi
	if [ "$ts" = 1 ] && [ -S "$HOME/.local/run/tailscale/tailscaled.sock" ]; then
		export NODE_USE_ENV_PROXY=1 HTTPS_PROXY=http://127.0.0.1:1055 HTTP_PROXY=http://127.0.0.1:1055
		export NO_PROXY="localhost,127.0.0.1${NO_PROXY:+,$NO_PROXY}$extra"
	fi
fi

exec node "$KIT/$FILE" "$@"
